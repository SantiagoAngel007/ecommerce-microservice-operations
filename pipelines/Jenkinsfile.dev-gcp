#!/usr/bin/env groovy

/**
 * JENKINSFILE.DEV-GCP
 *
 * Pipeline de CI/CD para ambiente DEV en GCP
 * - Autenticación con gcloud + Workload Identity
 * - Artifact Registry en lugar de Docker Hub
 * - kubectl nativo de GCP
 * - Validaciones de Terraform y código
 *
 * Trigger: Automático por push a rama main (dev)
 * Frecuencia: Cada commit
 */

def setupGCPAuth() {
    """
    Autentica con GCP usando Workload Identity
    """
    sh '''
        echo "🔐 Configurando autenticación con GCP..."

        # Usar credenciales del service account
        gcloud auth activate-service-account --key-file=${GCP_CREDENTIALS_FILE}

        # Establecer proyecto
        gcloud config set project ${GCP_PROJECT_ID}

        # Configurar Docker para usar Artifact Registry
        gcloud auth configure-docker ${GCP_REGION}-docker.pkg.dev

        echo "✅ Autenticación a GCP completada"
    '''
}

def getKubeConfig() {
    """
    Obtiene kubeconfig de GKE DEV (cluster zonal en us-central1-a)
    """
    sh '''
        echo "🔗 Obteniendo credenciales de GKE DEV..."

        # Obtener credenciales del cluster GKE (zonal, no regional)
        gcloud container clusters get-credentials ecommerce-${ENVIRONMENT}-cluster \
            --zone=us-central1-a \
            --project=${GCP_PROJECT_ID}

        # Verificar conexión
        echo "Verificando conexión a Kubernetes..."
        kubectl cluster-info
        kubectl get nodes

        echo "✅ Conexión a GKE DEV establecida (cluster zonal)"
    '''
}

def validateClusterHealth() {
    """
    Valida que el cluster GKE tiene nodos listos y recursos suficientes
    CRÍTICO: Evita desplegar en clusters sin nodos o con recursos insuficientes
    
    Requisitos por ambiente:
    - DEV: Mínimo 1 nodo (e2-medium: 2 vCPU, 4GB RAM)
    - STAGE: Mínimo 2 nodos (e2-standard-2: 2 vCPU, 8GB RAM)
    - PROD: Mínimo 3 nodos (e2-standard-4: 4 vCPU, 16GB RAM)
    """
    sh '''
        echo "🏥 Validando salud del cluster ${ENVIRONMENT}..."
        echo "=================================================="
        
        # Configuración de requisitos por ambiente
        case "${ENVIRONMENT}" in
            dev)
                MIN_NODES=1
                EXPECTED_MACHINE="e2-medium"
                ZONE_TYPE="zonal"
                CLUSTER_ZONE="us-central1-a"
                ;;
            stage)
                MIN_NODES=2
                EXPECTED_MACHINE="e2-standard-2"
                ZONE_TYPE="regional"
                CLUSTER_ZONE="us-central1"
                ;;
            prod)
                MIN_NODES=3
                EXPECTED_MACHINE="e2-standard-4"
                ZONE_TYPE="regional"
                CLUSTER_ZONE="us-central1"
                ;;
            *)
                echo "⚠️  Ambiente desconocido: ${ENVIRONMENT}"
                MIN_NODES=1
                EXPECTED_MACHINE="unknown"
                ZONE_TYPE="unknown"
                CLUSTER_ZONE="us-central1-a"
                ;;
        esac
        
        echo "📋 Requisitos para ambiente ${ENVIRONMENT}:"
        echo "  - Nodos mínimos: ${MIN_NODES}"
        echo "  - Tipo de máquina esperado: ${EXPECTED_MACHINE}"
        echo "  - Tipo de cluster: ${ZONE_TYPE}"
        echo "  - Zona/Región: ${CLUSTER_ZONE}"
        echo ""
        
        # 1. VERIFICAR ESTADO DEL CLUSTER
        echo "🔍 Verificando estado del cluster..."
        CLUSTER_STATUS=$(gcloud container clusters describe ecommerce-${ENVIRONMENT}-cluster \
            --zone=${CLUSTER_ZONE} \
            --format="get(status)" 2>/dev/null || echo "NOT_FOUND")
        
        if [ "${CLUSTER_STATUS}" = "NOT_FOUND" ]; then
            echo "❌ ERROR: Cluster ecommerce-${ENVIRONMENT}-cluster no existe"
            exit 1
        fi
        
        if [ "${CLUSTER_STATUS}" != "RUNNING" ]; then
            echo "❌ ERROR: Cluster no está en estado RUNNING"
            echo "  Estado actual: ${CLUSTER_STATUS}"
            exit 1
        fi
        
        echo "  ✅ Cluster estado: ${CLUSTER_STATUS}"
        
        # 2. VERIFICAR NÚMERO DE NODOS
        echo ""
        echo "🔍 Verificando nodos del cluster..."
        NODE_COUNT=$(kubectl get nodes --no-headers 2>/dev/null | wc -l)
        echo "  Nodos detectados: ${NODE_COUNT}"
        echo "  Nodos requeridos: ${MIN_NODES}"
        
        if [ "${NODE_COUNT}" -eq 0 ]; then
            echo ""
            echo "❌ ERROR CRÍTICO: Cluster NO tiene nodos disponibles"
            echo ""
            echo "🔧 SOLUCIÓN: Escalar el cluster ahora:"
            if [ "${ZONE_TYPE}" = "zonal" ]; then
                echo "  gcloud container clusters resize ecommerce-${ENVIRONMENT}-cluster \\"
                echo "    --num-nodes=${MIN_NODES} \\"
                echo "    --zone=${CLUSTER_ZONE} \\"
                echo "    --quiet"
            else
                echo "  gcloud container clusters resize ecommerce-${ENVIRONMENT}-cluster \\"
                echo "    --num-nodes=${MIN_NODES} \\"
                echo "    --region=${CLUSTER_ZONE} \\"
                echo "    --quiet"
            fi
            echo ""
            echo "⏳ Los nodos tardan ~2-3 minutos en estar listos"
            exit 1
        fi
        
        if [ "${NODE_COUNT}" -lt "${MIN_NODES}" ]; then
            echo ""
            echo "⚠️  ADVERTENCIA: Menos nodos de los recomendados"
            echo "  Detectados: ${NODE_COUNT}"
            echo "  Recomendados: ${MIN_NODES}"
            echo ""
            echo "🔧 RECOMENDACIÓN: Escalar a ${MIN_NODES} nodos para mejor disponibilidad"
        fi
        
        # 3. VERIFICAR QUE TODOS LOS NODOS ESTÁN READY
        echo ""
        echo "🔍 Verificando estado de nodos..."
        READY_NODES=$(kubectl get nodes --no-headers 2>/dev/null | grep -c " Ready " || echo "0")
        NOT_READY=$(kubectl get nodes --no-headers 2>/dev/null | grep -v " Ready " | wc -l)
        
        echo "  Nodos Ready: ${READY_NODES}"
        echo "  Nodos Not Ready: ${NOT_READY}"
        
        if [ "${NOT_READY}" -gt 0 ]; then
            echo ""
            echo "⚠️  ADVERTENCIA: Hay nodos que NO están Ready"
            kubectl get nodes
            echo ""
            echo "⏳ Esperando 90 segundos a que los nodos estén listos..."
            sleep 90
            
            # Re-verificar
            NOT_READY=$(kubectl get nodes --no-headers 2>/dev/null | grep -v " Ready " | wc -l)
            READY_NODES=$(kubectl get nodes --no-headers 2>/dev/null | grep -c " Ready " || echo "0")
            
            if [ "${NOT_READY}" -gt 0 ]; then
                echo ""
                echo "❌ ERROR: ${NOT_READY} nodos aún NO están Ready después de 90s"
                kubectl get nodes
                kubectl describe nodes | grep -A 5 "Conditions:"
                exit 1
            fi
            
            echo "  ✅ Todos los nodos ahora están Ready"
        fi
        
        echo "  ✅ Todos los ${READY_NODES} nodos están Ready"
        
        # 4. VERIFICAR TIPO DE MÁQUINA
        echo ""
        echo "🔍 Verificando tipo de máquinas..."
        MACHINE_TYPES=$(kubectl get nodes -o jsonpath='{.items[*].metadata.labels.node\.kubernetes\.io/instance-type}' 2>/dev/null || echo "unknown")
        echo "  Tipos detectados: ${MACHINE_TYPES}"
        
        if echo "${MACHINE_TYPES}" | grep -q "${EXPECTED_MACHINE}"; then
            echo "  ✅ Tipo de máquina correcto: ${EXPECTED_MACHINE}"
        else
            echo "  ⚠️  Tipo de máquina diferente al esperado (${EXPECTED_MACHINE})"
        fi
        
        # 5. MOSTRAR DETALLES DE NODOS
        echo ""
        echo "📊 Detalles de nodos:"
        kubectl get nodes -o wide
        
        # 6. VERIFICAR RECURSOS DISPONIBLES
        echo ""
        echo "🔍 Verificando recursos disponibles..."
        
        # CPU y Memoria totales
        TOTAL_CPU=$(kubectl get nodes -o jsonpath='{.items[*].status.capacity.cpu}' | tr ' ' '+' | bc 2>/dev/null || echo "N/A")
        TOTAL_MEMORY=$(kubectl get nodes -o jsonpath='{.items[*].status.capacity.memory}' | head -1 | sed 's/Ki$//' 2>/dev/null || echo "N/A")
        
        if [ "${TOTAL_CPU}" != "N/A" ]; then
            TOTAL_MEMORY_GB=$(echo "scale=2; ${TOTAL_MEMORY} / 1024 / 1024" | bc 2>/dev/null || echo "N/A")
            echo "  Capacidad total del cluster:"
            echo "    CPU: ${TOTAL_CPU} vCPUs"
            echo "    Memoria: ${TOTAL_MEMORY_GB} GB"
        fi
        
        # Uso actual de recursos (si Metrics Server está disponible)
        echo ""
        echo "📊 Uso actual de recursos:"
        if kubectl top nodes 2>/dev/null; then
            # Verificar si algún nodo está sobrecargado
            kubectl top nodes --no-headers 2>/dev/null | while read node cpu mem; do
                cpu_pct=$(echo $cpu | sed 's/%$//')
                mem_pct=$(echo $mem | sed 's/%$//')
                
                if [ "${cpu_pct}" -gt 80 ]; then
                    echo "  ⚠️  Nodo ${node} con CPU alta: ${cpu}%"
                fi
                if [ "${mem_pct}" -gt 85 ]; then
                    echo "  ⚠️  Nodo ${node} con Memoria alta: ${mem}%"
                fi
            done
        else
            echo "  ℹ️  Metrics Server no disponible (no es crítico)"
        fi
        
        # 7. VERIFICAR PODS PREVIOS EN EL NAMESPACE
        echo ""
        echo "🔍 Verificando namespace ${ENVIRONMENT}..."
        if kubectl get namespace ${ENVIRONMENT} 2>/dev/null; then
            echo "  ✅ Namespace existe"
            
            # Contar pods en estado Pending
            PENDING_PODS=$(kubectl get pods -n ${ENVIRONMENT} --no-headers 2>/dev/null | grep -c "Pending" || echo "0")
            if [ "${PENDING_PODS}" -gt 0 ]; then
                echo ""
                echo "⚠️  ADVERTENCIA: Hay ${PENDING_PODS} pods en estado Pending"
                echo "  Esto puede indicar falta de recursos o problemas previos"
                echo ""
                echo "  Pods Pending:"
                kubectl get pods -n ${ENVIRONMENT} --no-headers 2>/dev/null | grep "Pending" | awk '{print "    - " $1 " (" $3 ")"}'
                echo ""
                echo "  🔧 SOLUCIÓN: Eliminar pods pendientes antiguos antes de desplegar:"
                echo "    kubectl delete pods -n ${ENVIRONMENT} --field-selector=status.phase=Pending"
                echo ""
                read -p "  ¿Eliminar pods Pending automáticamente? (y/N): " -t 10 response || response="n"
                if [ "$response" = "y" ] || [ "$response" = "Y" ]; then
                    kubectl delete pods -n ${ENVIRONMENT} --field-selector=status.phase=Pending
                    echo "  ✅ Pods Pending eliminados"
                else
                    echo "  ⚠️  Continuando con pods Pending (pueden interferir con el deploy)"
                fi
            fi
            
            # Mostrar estado general de pods
            echo ""
            echo "  Estado actual de pods:"
            kubectl get pods -n ${ENVIRONMENT} --no-headers 2>/dev/null | awk '{print $3}' | sort | uniq -c | awk '{print "    " $2 ": " $1}' || echo "    (sin pods)"
        else
            echo "  ℹ️  Namespace no existe, será creado durante el deploy"
        fi
        
        # 8. VERIFICAR NODE POOLS
        echo ""
        echo "🔍 Verificando node pools..."
        if [ "${ZONE_TYPE}" = "zonal" ]; then
            gcloud container node-pools list \
                --cluster=ecommerce-${ENVIRONMENT}-cluster \
                --zone=${CLUSTER_ZONE} \
                --format="table(name,machineType,diskSizeGb,nodeVersion)" 2>/dev/null || echo "  Error al obtener node pools"
        else
            gcloud container node-pools list \
                --cluster=ecommerce-${ENVIRONMENT}-cluster \
                --region=${CLUSTER_ZONE} \
                --format="table(name,machineType,diskSizeGb,nodeVersion)" 2>/dev/null || echo "  Error al obtener node pools"
        fi
        
        # 9. RESUMEN FINAL
        echo ""
        echo "=================================================="
        echo "✅ VALIDACIÓN DE CLUSTER COMPLETADA"
        echo "=================================================="
        echo "Ambiente: ${ENVIRONMENT} (${ZONE_TYPE})"
        echo "Cluster: ecommerce-${ENVIRONMENT}-cluster"
        echo "Estado: ${CLUSTER_STATUS}"
        echo "Nodos Ready: ${READY_NODES}/${NODE_COUNT}"
        echo "Tipo de máquina: ${EXPECTED_MACHINE}"
        echo "Namespace: ${ENVIRONMENT}"
        echo ""
        
        if [ "${READY_NODES}" -ge "${MIN_NODES}" ]; then
            echo "🎯 Cluster listo para recibir deploy"
        else
            echo "⚠️  Cluster funcional pero por debajo del mínimo recomendado"
        fi
        echo "=================================================="
    '''
}

def validateTerraformOutputs() {
    """
    Valida que la infraestructura de Terraform está disponible
    """
    sh '''
        echo "📋 Validando outputs de Terraform..."

        # Copiar credenciales GCP al lugar esperado por Terraform
        mkdir -p ops/terraform/credentials
        cp "${GCP_CREDENTIALS_FILE}" ops/terraform/credentials/gcp-key.json

        cd ops/terraform/environments/${ENVIRONMENT}

        # Configurar credenciales para Terraform
        export GOOGLE_APPLICATION_CREDENTIALS="../../credentials/gcp-key.json"

        # Inicializar Terraform
        terraform init -backend=true

        # Obtener outputs
        echo "Extrayendo información de infraestructura..."
        CLUSTER_NAME=$(terraform output -raw gke_cluster_name 2>/dev/null || echo "ecommerce-${ENVIRONMENT}-cluster")
        REGISTRY_URL=$(terraform output -raw artifact_registry_url 2>/dev/null || echo "${GCP_REGION}-docker.pkg.dev/${GCP_PROJECT_ID}/${ARTIFACT_REGISTRY_REPO}")

        echo "  Cluster GKE: ${CLUSTER_NAME}"
        echo "  Artifact Registry: ${REGISTRY_URL}"

        if [ "${CLUSTER_NAME}" = "ecommerce-${ENVIRONMENT}-cluster" ]; then
            echo "⚠️ Usando valores por defecto (outputs de Terraform no disponibles)"
            echo "   La infraestructura debe estar creada manualmente"
        fi

        echo "✅ Validación de Terraform completada"
    '''
}

def checkoutCode() {
    """
    Clona el repositorio de código desde la rama DEV
    """
    sh '''
        echo "🔄 Clonando repositorio de código (rama dev)..."
        rm -rf code
        mkdir -p code
        cd code
        git clone -b dev https://github.com/SantiagoAngel007/ecommerce-microservice-backend-app.git .
        echo "✅ Código clonado desde rama dev"
    '''
}

def checkoutOps() {
    """
    Clona el repositorio de operaciones
    """
    sh '''
        echo "🔄 Clonando repositorio de operaciones..."
        rm -rf ops
        mkdir -p ops
        cd ops
        git clone -b main https://github.com/SantiagoAngel007/ecommerce-microservice-operations.git .
        echo "✅ Operaciones clonadas"
    '''
}

def buildAndPushImages() {
    """
    Compila servicios y sube imágenes a Artifact Registry
    """
    sh '''
        echo "🐳 Compilando e subiendo imágenes a Artifact Registry..."

        SERVICES="service-discovery proxy-client user-service product-service order-service payment-service favourite-service shipping-service"

        cd code

        for service in $SERVICES; do
            echo ""
            echo "────────────────────────────────────"
            echo "📦 Procesando: ${service}"
            echo "────────────────────────────────────"

            # 1. Compilar con Maven
            echo "Compilando ${service}..."
            cd ${service}
            mvn clean package -DskipTests -q
            if [ $? -ne 0 ]; then
                echo "❌ Compilación de ${service} falló"
                exit 1
            fi
            echo "✅ ${service} compilado"
            cd ..

            # 2. Construir imagen Docker
            IMAGE_NAME="${GCP_REGION}-docker.pkg.dev/${GCP_PROJECT_ID}/${ARTIFACT_REGISTRY_REPO}/${service}:${DOCKER_TAG}"
            echo "Construyendo imagen: ${IMAGE_NAME}"

            docker build \
                -t ${IMAGE_NAME} \
                -f ${service}/Dockerfile \
                . \
                --no-cache

            if [ $? -ne 0 ]; then
                echo "❌ Build Docker de ${service} falló"
                exit 1
            fi
            echo "✅ Imagen construida"

            # 3. Subir a Artifact Registry
            echo "Subiendo a Artifact Registry..."
            docker push ${IMAGE_NAME}

            if [ $? -ne 0 ]; then
                echo "❌ Push de ${service} falló"
                exit 1
            fi
            echo "✅ ${service} subido a Artifact Registry"
        done

        cd ..
        echo ""
        echo "✅ Todas las imágenes procesadas exitosamente"
    '''
}

def runTrivy() {
    """
    Escanea vulnerabilidades en imágenes Docker con Trivy
    - Genera reportes JSON para cada servicio
    - Si FAIL_ON_VULNERABILITIES=true, falla el pipeline si encuentra HIGH/CRITICAL
    """
    sh '''
        if [ "${SCAN_VULNERABILITIES}" != "true" ]; then
            echo "⏭️  Escaneo de vulnerabilidades deshabilitado"
            return 0
        fi

        echo "🔍 Escaneando vulnerabilidades con Trivy..."

        # Instalar Trivy en directorio local si no existe
        TRIVY_BIN="${WORKSPACE}/trivy"
        if ! command -v trivy &> /dev/null && [ ! -f "${TRIVY_BIN}" ]; then
            echo "Instalando Trivy en ${WORKSPACE}..."
            curl -sfL https://raw.githubusercontent.com/aquasecurity/trivy/main/contrib/install.sh | sh -s -- -b ${WORKSPACE} || {
                echo "❌ Error instalando Trivy"
                exit 1
            }
            chmod +x ${TRIVY_BIN}
        fi
        
        # Usar trivy local o del sistema
        if [ -f "${TRIVY_BIN}" ]; then
            TRIVY_CMD="${TRIVY_BIN}"
        else
            TRIVY_CMD="trivy"
        fi
        
        echo "Usando Trivy: ${TRIVY_CMD}"
        ${TRIVY_CMD} --version || {
            echo "❌ Trivy no funciona correctamente"
            exit 1
        }
        
        # Configurar autenticación Docker para Artifact Registry
        echo "Configurando autenticación para Artifact Registry..."
        gcloud auth configure-docker ${GCP_REGION}-docker.pkg.dev --quiet

        SERVICES="service-discovery proxy-client user-service product-service order-service payment-service favourite-service shipping-service"

        mkdir -p trivy-reports
        TOTAL_HIGH=0
        TOTAL_CRITICAL=0
        FAILED_SERVICES=""

        for service in $SERVICES; do
            IMAGE_NAME="${GCP_REGION}-docker.pkg.dev/${GCP_PROJECT_ID}/${ARTIFACT_REGISTRY_REPO}/${service}:${DOCKER_TAG}"

            echo "Escaneando: ${service}"
            echo "  Imagen: ${IMAGE_NAME}"
            
            # Intentar escanear con timeout de 5 minutos
            timeout 300 ${TRIVY_CMD} image --severity HIGH,CRITICAL \
                --format json \
                --output trivy-reports/${service}-scan.json \
                ${IMAGE_NAME} 2>&1 || {
                echo "  ⚠️  Error escaneando ${service} (continuando...)"
                continue
            }

            # Contar vulnerabilidades HIGH y CRITICAL
            if [ -f "trivy-reports/${service}-scan.json" ]; then
                HIGH=$(grep -o '"Severity":"HIGH"' trivy-reports/${service}-scan.json | wc -l || echo 0)
                CRITICAL=$(grep -o '"Severity":"CRITICAL"' trivy-reports/${service}-scan.json | wc -l || echo 0)
                
                TOTAL_HIGH=$((TOTAL_HIGH + HIGH))
                TOTAL_CRITICAL=$((TOTAL_CRITICAL + CRITICAL))

                if [ $HIGH -gt 0 ] || [ $CRITICAL -gt 0 ]; then
                    echo "  ⚠️  ${service}: ${CRITICAL} CRITICAL, ${HIGH} HIGH"
                    FAILED_SERVICES="${FAILED_SERVICES} ${service}"
                else
                    echo "  ✅ ${service}: Sin vulnerabilidades HIGH/CRITICAL"
                fi
            fi
        done

        echo ""
        echo "📊 RESUMEN DE VULNERABILIDADES:"
        echo "  Total CRITICAL: ${TOTAL_CRITICAL}"
        echo "  Total HIGH: ${TOTAL_HIGH}"
        
        if [ -n "${FAILED_SERVICES}" ]; then
            echo "  Servicios afectados:${FAILED_SERVICES}"
        fi

        # Fallar pipeline si está habilitado y hay vulnerabilidades
        if [ "${FAIL_ON_VULNERABILITIES}" = "true" ]; then
            if [ $TOTAL_CRITICAL -gt 0 ] || [ $TOTAL_HIGH -gt 0 ]; then
                echo ""
                echo "❌ PIPELINE FALLADO: Se encontraron vulnerabilidades HIGH/CRITICAL"
                exit 1
            fi
        else
            echo ""
            echo "ℹ️  FAIL_ON_VULNERABILITIES=false - Pipeline continúa a pesar de vulnerabilidades"
        fi

        echo "✅ Escaneo de vulnerabilidades completado"
    '''
}

def runSonarCloud() {
    """
    Análisis estático de código con SonarCloud
    Realiza análisis de calidad de código y genera reportes
    """
    sh '''
        echo "📊 Ejecutando análisis SonarCloud..."

        if [ -z "${SONARCLOUD_TOKEN}" ] || [ -z "${SONARCLOUD_ORG}" ] || [ -z "${SONARCLOUD_PROJECT}" ]; then
            echo "⚠️  SonarCloud no configurado. Configura:"
            echo "   - SONARCLOUD_TOKEN: Jenkins Credentials"
            echo "   - SONARCLOUD_ORG: Tu organization key en SonarCloud"
            echo "   - SONARCLOUD_PROJECT: Tu project key en SonarCloud"
            return 0
        fi

        cd code

        mvn sonar:sonar \
            -Dsonar.projectKey=${SONARCLOUD_PROJECT} \
            -Dsonar.organization=${SONARCLOUD_ORG} \
            -Dsonar.host.url=https://sonarcloud.io \
            -Dsonar.login=${SONARCLOUD_TOKEN} \
            -Dsonar.sources=. \
            -q

        echo "✅ Análisis SonarCloud completado"
        echo "   URL: https://sonarcloud.io/dashboard?id=${SONARCLOUD_PROJECT}"

        cd ..
    '''
}

